# Choose your LLM provider: anthropic or gemini
LLM_PROVIDER=gemini

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Gemini (only needed if LLM_PROVIDER=gemini) - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DATA_SOURCE=mock
