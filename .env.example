# Choose your LLM provider: anthropic or gemini
LLM_PROVIDER=gemini

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Gemini (only needed if LLM_PROVIDER=gemini) - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DATA_SOURCE=mock

# --- QuickLook dealer usage API (GetUsageStats) ---
# Independent of DATA_SOURCE/GA4. Set the token to switch dealer-usage tools
# from demo data to live. The host is internal - the STARS server must be able
# to reach it. Leave the token blank to keep demo data.
QUICKLOOK_API_TOKEN=
QUICKLOOK_BASE_URL=https://quicklook.orientbell.com
# Optional overrides:
# QUICKLOOK_ENABLED=1                       # set 0 to force demo even with a token
# QUICKLOOK_ROW_CAP=100000                  # safety ceiling on rows per query
# DEALER_DIRECTORY_CSV=data/dealer_hierarchy.csv  # dealer -> branch/zone lookup

# --- Meta (Facebook + Instagram) Ads via the Marketing/Graph API ---
# Set both to go live (independent of DATA_SOURCE). Leave blank to keep demo data.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
# Optional:
# META_API_VERSION=v21.0
# META_CONVERSION_ACTION=purchase           # action_type counted as a conversion
#                                           # (e.g. lead, offsite_conversion.fb_pixel_purchase)
# META_ADS_ENABLED=1                        # set 0 to force demo even with a token

# --- Zoho (OAuth2 refresh-token flow) ---
# Generate the refresh token out-of-band (Swagger/console); STARS mints access
# tokens from it automatically. Region-specific URLs (.in / .com / .eu ...).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
# ZOHO_ENABLED=1                            # set 0 to force off
